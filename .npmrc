# Build scripts we explicitly trust. pnpm blocks postinstall by default;
# these are needed for native binaries (Prisma engines, esbuild, swc).
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=@swc/core
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=msgpackr-extract
onlyBuiltDependencies[]=msw
