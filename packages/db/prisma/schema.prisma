// Mindforge schema — the curriculum flow, and nothing else (v0.2 refocus).
//
// Scope is TECH-DESIGN.md §3.1, §3.2 and §3.5: missions and their revisions,
// tracks (modules) and their edges, lessons, reference docs, learning records,
// the sync ledger, agent runs, what they cost, learner memory — plus the two
// trackers that read effort: focus sessions (time) and the daily rollup
// (frequency). M4 adds lessons.difficulty/depth/status and lesson_edges with
// the parser and UI that write them.
//
// Two rules this file follows throughout:
//   1. Enum-ish columns are stored as keys, never display text. The UI
//      translates at render (§5.2), so `understood` and `deep_dive` are stable
//      contract, not copy.
//   2. Every user-owned table carries userId and gets an RLS policy plus an
//      RLS test in the same migration. Prisma cannot express policies, so they
//      are hand-appended to the bottom of that migration's `migration.sql` —
//      a sibling `rls.sql` would be silently ignored and the table would ship
//      with RLS off. Nor can Prisma express check constraints or partial
//      unique indexes, which live in the same place for the same reason.

generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

// Prisma 7 moved connection URLs out of the schema: the migration datasource
// lives in prisma.config.ts, and the runtime client is given the pooled URL
// separately. That split is convenient here — migrations need the direct
// connection, the app needs pgbouncer.
datasource db {
  provider = "postgresql"
}

/// Mirrors auth.users. Prisma cannot own that table, so this is a shadow row
/// created by a trigger on signup — it exists to hang preferences off.
model Profile {
  id                   String   @id @db.Uuid
  /// IANA. Every "day", "week", and nightly job derives from this, never from
  /// server-local time (§5.2).
  timezone             String   @default("UTC")
  /// UI locale: interface strings, dates, numbers.
  locale               String   @default("en")
  /// What the agent writes lessons in. Separate on purpose — a pt-BR interface
  /// with English lessons is a legitimate and likely combination (FR-L3).
  contentLanguage      String   @default("en") @map("content_language")
  /// Seeded from locale, then user-owned: pt-BR convention is Sunday, and the
  /// activity grid's columns depend on it (FR-L4). 0 = Sunday.
  weekStartsOn         Int      @default(1) @map("week_starts_on")
  theme                String   @default("light")
  /// The release whose changelog you last opened. Drives the unseen-entries dot
  /// on Settings and nothing else — null means you have never opened it, which
  /// is why it is nullable rather than defaulted to the current version (§14.1).
  changelogSeenVersion String?  @map("changelog_seen_version")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  missions        Mission[]
  tracks          Track[]
  focusSessions   FocusSession[]
  dailyActivity   DailyActivity[]
  lessons         Lesson[]
  referenceDocs   ReferenceDoc[]
  learningRecords LearningRecord[]
  workspaceFiles  WorkspaceFile[]
  agentRuns       AgentRun[]
  llmCalls        LlmCall[]
  learnerMemories LearnerMemory[]

  @@map("profiles")
}

model Mission {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  topic            String
  why              String?
  successLooksLike String?  @map("success_looks_like")
  constraints      String?
  currentLevel     String?  @map("current_level")
  /// active | parked | completed | abandoned. Parked is not archived — the
  /// curriculum and its history stay (FR-M3).
  status           String   @default("active")
  /// Storage prefix under `workspaces/<user_id>/`. Set once at first
  /// materialisation: renaming a mission must not move files. Unique per user,
  /// not globally — the path is already scoped by user id, and a global unique
  /// would let the first account to claim `rust` take it from everyone and leak
  /// that it had, through the 409.
  workspaceKey     String?  @map("workspace_key")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile         Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  revisions       MissionRevision[]
  tracks          Track[]
  sessions        FocusSession[]
  lessons         Lesson[]
  referenceDocs   ReferenceDoc[]
  learningRecords LearningRecord[]
  workspaceFiles  WorkspaceFile[]
  agentRuns       AgentRun[]

  @@unique([userId, workspaceKey])
  @@index([userId, status])
  @@map("missions")
}

/// Append-only. Mission drift is a signal, not noise (FR-M2).
model MissionRevision {
  id        String   @id @default(uuid()) @db.Uuid
  missionId String   @map("mission_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)
  reason    String
  snapshot  Json

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, changedAt])
  @@map("mission_revisions")
}

/// A subtopic of a mission, and the module its lessons belong to (FR-K1).
///
/// Written by the `curriculum` skill from `CURRICULUM.md`, which is canonical —
/// this rebuilds by re-reading a workspace like everything else in the index.
model Track {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  missionId String @map("mission_id") @db.Uuid
  /// Stable, and what each lesson's `<meta name="mindforge:track">` names.
  /// Renaming the track is free; changing this orphans its module.
  slug      String
  name      String
  /// One line, observable: what you can do once the module is finished.
  outcome   String?
  /// The curriculum's recommended reading order, fundamentals first. A **plan**:
  /// hard sequencing comes from `track_edges` (FR-K1).
  position  Int
  /// proposed | active | done | dropped. A track absent from a regenerated
  /// `CURRICULUM.md` is marked `dropped`, never deleted: the agent rewrites the
  /// file wholesale, and a deletion would take a module of finished lessons.
  status    String @default("proposed")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile   Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission   Mission     @relation(fields: [missionId], references: [id], onDelete: Cascade)
  prereqOf  TrackEdge[] @relation("track")
  requires  TrackEdge[] @relation("trackPrereq")
  lessons   Lesson[]
  agentRuns AgentRun[]

  @@unique([missionId, slug])
  @@index([userId, missionId, position])
  @@map("tracks")
}

/// Prerequisite DAG over tracks. Cycle prevention lives in the application layer
/// — a constraint cannot express it, so the writer checks before writing.
model TrackEdge {
  userId   String @map("user_id") @db.Uuid
  trackId  String @map("track_id") @db.Uuid
  prereqId String @map("prereq_id") @db.Uuid

  track  Track @relation("track", fields: [trackId], references: [id], onDelete: Cascade)
  prereq Track @relation("trackPrereq", fields: [prereqId], references: [id], onDelete: Cascade)

  @@id([trackId, prereqId])
  @@map("track_edges")
}

/// The time tracker's row (FR-F1..F3): a bounded block of attention, usually
/// on a mission's curriculum, and since M5 often on one lesson of it.
model FocusSession {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  missionId      String?   @map("mission_id") @db.Uuid
  /// What the time bought (FR-F3). Set by starting the timer from the reader,
  /// never by a picker — binding is optional and never asked twice.
  ///
  /// Implies `missionId`, and the application is what keeps that true:
  /// `ResolveSessionSubject` reads the lesson and takes the mission from it. The
  /// migration explains at length why neither a CHECK nor a MATCH FULL composite
  /// key can hold the rule — both were tried, and both break deleting a mission.
  lessonId       String?   @map("lesson_id") @db.Uuid
  /// "What does done look like for this block?" — one field, asked at start.
  intention      String?
  startedAt      DateTime  @map("started_at") @db.Timestamptz(6)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(6)
  plannedMinutes Int?      @map("planned_minutes")
  /// Debrief, ≤30s: yes | partly | no
  hitIntention   String?   @map("hit_intention")
  focusQuality   Int?      @map("focus_quality")
  energy         Int?
  note           String?
  /// timer | manual | backfilled. You WILL forget the timer, and backfilled
  /// data must be distinguishable without being second-class (FR-F2).
  entryMode      String    @default("timer") @map("entry_mode")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  /// SetNull, like the mission: the session is the expensive artifact and the
  /// binding is the cheap one. A deleted lesson must not take an hour of recorded
  /// attention with it — the minutes were still spent.
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, missionId, startedAt])
  @@index([userId, lessonId])
  @@map("focus_sessions")
}

/// The frequency tracker's cache (FR-Q2). Every grid reads this and never raw
/// sessions — 365 rows a year makes the activity grid one indexed query.
///
/// A cache, never authoritative: nothing decides anything from it, nothing
/// else writes it, and it rebuilds from raw rows at any moment. That is the
/// one exemption to "derived numbers are computed on read".
model DailyActivity {
  userId String   @map("user_id") @db.Uuid
  /// In the user's timezone, not UTC. A "day" that rolls over at 4pm local is
  /// a bug, not a rounding difference (§10).
  day    DateTime @db.Date

  focusMinutes Int @default(0) @map("focus_minutes")
  sessionCount Int @default(0) @map("session_count")

  /// When the rollup last wrote this row. A stale grid and an empty grid look
  /// identical without it, and the nightly job is the thing most likely to fail
  /// silently.
  rebuiltAt DateTime @default(now()) @map("rebuilt_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("daily_activity")
}

// ---------------------------------------------------------------------------
// The teach workspace (M3) — §3.2, §3.5, §7.2-§7.6.
//
// Every model below is an index over files. Storage is canonical
// (non-negotiable 5) and all of this rebuilds by re-reading a workspace, which
// is what makes a defensive parser the right answer to a format change: a row
// that cannot be reconstructed is a row that should not have been trusted.
// ---------------------------------------------------------------------------

/// One `./lessons/NNNN-slug.html`. The primary unit of teaching (FR-T5).
///
/// M4 widens this into the planned-lesson model (§3.2b): status
/// planned | generated, difficulty, depth, and `lesson_edges` — the plan is
/// what makes module progress a real fraction (FR-P2).
model Lesson {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @map("user_id") @db.Uuid
  missionId   String  @map("mission_id") @db.Uuid
  /// The module this lesson belongs to, from the lesson's own
  /// `<meta name="mindforge:track">` — never from `CURRICULUM.md`, which the
  /// agent rewrites wholesale and which would give the fact a second home to
  /// disagree with. Null is legal and permanent for two cases: lessons written
  /// before the mission had a curriculum, and lessons taught deliberately
  /// off-plan.
  trackId     String? @map("track_id") @db.Uuid
  /// planned | generated. A **planned** lesson is a row `CURRICULUM.md` wrote
  /// before anything existed to read: no file, no sequence number, no hash.
  /// Generation fills that same row in and flips it to `generated` — one row with
  /// two lives, not two rows joined, because two rows means the module's
  /// denominator silently gains a lesson the learner has already finished.
  status      String  @default("generated")
  /// From the filename, never from the document. An H1 is prose the agent
  /// rewrites; the number is the workspace's own ordering, and it is what a
  /// learning record links back to. Mission-global: numbering does not restart
  /// per track, because the file layout has no per-track directory and files are
  /// canonical. Null while the lesson is only planned.
  seq         Int?
  /// The plan's identity, and what a generated lesson claims its plan entry by
  /// (`<meta name="mindforge:lesson">`). Unique per mission **among planned rows**
  /// only: once claimed the row leaves that index, so two written lessons may
  /// share a filename slug.
  slug        String
  title       String
  /// **Relative to the mission's workspace prefix** — `lessons/0007-x.html`, not
  /// `workspaces/<user>/<key>/lessons/0007-x.html`. That is what the reindexer
  /// writes and what the reader appends to a view grant, and the two only compose
  /// because they agree. TECH-DESIGN §3.2 documented it the other way for two
  /// milestones; the first real teach run is what noticed, by rendering "there is
  /// no file behind this lesson" over a lesson sitting in Storage.
  ///
  /// Null while the lesson is only planned. `lessons_generated_has_file` is what
  /// keeps these three NOT NULL for everything with a file behind it.
  storagePath String? @map("storage_path")
  contentHash String? @map("content_hash")

  /// One line from `CURRICULUM.md`: what this lesson is for. Null off-plan.
  intent      String?
  /// 1–5, how hard for **this** learner at the level `MISSION.md` records — never
  /// a score for the learner. Null when the plan left it blank, and null is
  /// rendered as unknown rather than as a middling 3 (non-negotiable 10).
  difficulty  Int?    @db.SmallInt
  /// overview | working | deep_dive. How far down, not how long.
  depth       String?
  /// Row order within its module in `CURRICULUM.md`. A plan, like
  /// `tracks.position`: what unblocks next comes from `lessonEdges` and
  /// difficulty (FR-K7), and this only breaks ties and orders the display.
  position    Int?    @db.SmallInt

  /// Set by the sandboxed reader in M5. Until then it is null for every lesson,
  /// and null means "unread or not yet trackable" — the UI renders neither as a
  /// zero (non-negotiable 10).
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  /// understood | shaky | lost. The progress tracker's outcome (FR-P1).
  outcome     String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: if a track is ever removed by hand the lessons it held
  /// are the expensive artifact and the grouping is the cheap one (non-negotiable 6).
  track   Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)
  records LearningRecord[]
  /// Lessons this one is a prerequisite of, and the ones it depends on. Read
  /// backwards, `prereqOf` is the fundamental count (FR-K6).
  prereqOf LessonEdge[] @relation("lesson")
  requires LessonEdge[] @relation("lessonPrereq")
  /// The blocks of attention spent on it (FR-F3). M6's time views read these.
  focusSessions FocusSession[]

  @@unique([missionId, seq])
  @@index([userId, missionId])
  @@index([trackId, seq])
  @@index([trackId, position])
  @@map("lessons")
}

/// "A depends on B", between two planned or written lessons (FR-K2).
///
/// One edge, two readings, neither of them ever stored: forwards it locks A until
/// every B is completed (FR-K7); backwards it makes B fundamental, and the more
/// lessons depend on B the more fundamental it is (FR-K6). Both are computed on
/// read in `packages/core`.
///
/// Cascade on both sides, unlike `lessons.trackId`. An edge is not an artifact —
/// it is a statement about two lessons, and when either end is gone it is no
/// longer about anything.
model LessonEdge {
  userId   String @map("user_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid
  prereqId String @map("prereq_id") @db.Uuid

  lesson Lesson @relation("lesson", fields: [lessonId], references: [id], onDelete: Cascade)
  prereq Lesson @relation("lessonPrereq", fields: [prereqId], references: [id], onDelete: Cascade)

  @@id([lessonId, prereqId])
  @@index([userId, prereqId])
  @@map("lesson_edges")
}

/// One `./reference/slug.html` (FR-T6). The skill is explicit that these are the
/// artifacts you revisit, unlike lessons — so they get their own library.
model ReferenceDoc {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @map("user_id") @db.Uuid
  missionId   String @map("mission_id") @db.Uuid
  slug        String
  title       String
  storagePath String @map("storage_path")
  contentHash String @map("content_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  /// No NNNN on these: the skill revises a reference doc in place rather than
  /// superseding it, so the path is the natural key — and it is what stops a
  /// second reindex from doubling the library.
  @@unique([missionId, storagePath])
  @@index([userId, missionId])
  @@map("reference_docs")
}

/// One `./learning-records/NNNN-slug.md` (FR-T6). Mirrors the skill's
/// LEARNING-RECORD-FORMAT.md exactly. Append-only: a record that turns out wrong
/// is superseded by a new one rather than edited.
model LearningRecord {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  missionId String  @map("mission_id") @db.Uuid
  seq       Int
  title     String
  lessonId  String? @map("lesson_id") @db.Uuid

  whatLearned String  @map("what_learned")
  evidence    String?
  keyInsight  String? @map("key_insight")
  struggles   String?
  /// What this unlocks. Feeds the briefing so the agent starts warm.
  next        String?

  storagePath  String  @map("storage_path")
  contentHash  String  @map("content_hash")
  supersedesId String? @map("supersedes_id") @db.Uuid

  /// From the record's `Date:` line, resolved in the user's IANA timezone. A
  /// record dated 2026-08-08 that lands on 2026-08-07 moves which day it
  /// belongs to.
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(6)

  profile      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission      Mission          @relation(fields: [missionId], references: [id], onDelete: Cascade)
  lesson       Lesson?          @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  supersedes   LearningRecord?  @relation("RecordSupersedes", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy LearningRecord[] @relation("RecordSupersedes")

  @@unique([missionId, seq])
  @@index([userId, missionId, recordedAt])
  @@map("learning_records")
}

/// The sync ledger (§7.4). What was in Storage when a run materialised the
/// workspace, so the diff afterwards is cheap and a conflict is detectable.
model WorkspaceFile {
  userId      String @map("user_id") @db.Uuid
  missionId   String @map("mission_id") @db.Uuid
  /// Relative: "lessons/0007-closures.html".
  path        String
  contentHash String @map("content_hash")
  sizeBytes   Int    @map("size_bytes")

  /// md5(content), read from list()/info(). Detects a concurrent writer; it
  /// cannot exclude one, because Storage ignores If-Match on upload — probed,
  /// not assumed (§7.4).
  storageEtag    String? @map("storage_etag")
  /// The better change token, stored alongside rather than instead: it moves on
  /// every write, including one that leaves the bytes identical.
  storageVersion String? @map("storage_version")

  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@id([missionId, path])
  @@index([userId, missionId])
  @@map("workspace_files")
}

/// One invocation of the agent (FR-T3). Long operations never block a request:
/// the endpoint returns 202 with this id and the SPA subscribes for progress.
model AgentRun {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  /// Null for kinds that are not about one mission.
  missionId String? @map("mission_id") @db.Uuid
  /// The module a `generate_lesson` run is teaching within. Null for
  /// `generate_curriculum`, which precedes every track, and for anything not
  /// scoped to one module.
  trackId   String? @map("track_id") @db.Uuid

  /// generate_lesson | generate_curriculum | sync_workspace
  kind   String
  /// queued | running | succeeded | succeeded_with_conflicts | failed | cancelled.
  /// `succeeded_with_conflicts` is a success: the run did its work and kept both
  /// versions of every contested file (§7.4).
  status String  @default("queued")
  /// External job id, unused while the scheduler is an in-process setTimeout.
  jobId  String? @map("job_id")

  /// The rendered briefing among other things, so a bad lesson is debuggable
  /// after the fact rather than only reproducible.
  input  Json?
  /// Changes, parser warnings, and the SDK's own cost estimate as a cross-check
  /// against ours — never as the source of truth (§8.6).
  result Json?
  error  String?

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  /// Liveness lease, written on every message. A partial unique index allows one
  /// active run per mission; without a reaper for stale heartbeats, a worker that
  /// dies mid-run wedges that mission forever.
  heartbeatAt DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(6)

  profile  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission  Mission?  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  track    Track?    @relation(fields: [trackId], references: [id], onDelete: SetNull)
  llmCalls LlmCall[]

  @@index([userId, createdAt])
  @@index([status, heartbeatAt])
  /// A third index exists in SQL and cannot be written here: `(user_id,
  /// started_at DESC) WHERE started_at IS NOT NULL`, added by
  /// `20260815120000_dispatch_fairness_index`. Prisma cannot express a partial
  /// index, so — like the check constraints and the single-active-run unique
  /// index — it lives only in the migration. It backs round-robin dispatch in
  /// `prisma-dispatch.gateway.ts`; dropping it makes that query a sequential scan
  /// every five seconds.
  @@map("agent_runs")
}

/// Cost and cache-hit observability (§8.6). Non-negotiable 9: this ships with the
/// first LLM call, not after.
model LlmCall {
  id         String  @id @default(uuid()) @db.Uuid
  /// Never null. Every call in this product is made on somebody's behalf, and a
  /// cost row nobody owns is one RLS hides from everyone.
  userId     String  @map("user_id") @db.Uuid
  agentRunId String? @map("agent_run_id") @db.Uuid

  /// Call site. `teach_turn` is a visible assistant message; `teach_overhead` is
  /// the reconciliation row that makes a run's calls sum to its modelUsage —
  /// without it the SDK's own internal calls are billed to nobody, and they were
  /// 22% of the M3 probe run.
  purpose String
  model   String
  /// Per-run dedupe key: request_id where present, message.id otherwise.
  /// Parallel tool calls emit several assistant messages sharing one id and one
  /// cumulative usage figure.
  callKey String? @map("call_key")

  inputTokens      Int @default(0) @map("input_tokens")
  outputTokens     Int @default(0) @map("output_tokens")
  cacheReadTokens  Int @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int @default(0) @map("cache_write_tokens")

  /// Null when the model is not in the pricing table. Never 0 as a stand-in —
  /// zero is a measurement (non-negotiable 10).
  costUsd   Decimal? @map("cost_usd") @db.Decimal(10, 6)
  latencyMs Int?     @map("latency_ms")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Set null, not cascade: deleting a run must not delete what it cost.
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([agentRunId])
  @@map("llm_calls")
}

/// Index over `memory/<user_id>/*.md` (§7.6). Cross-mission facts about the
/// learner, replayed into every agent run — which is exactly why the user can
/// read, edit and delete every row of it.
model LearnerMemory {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  /// Filename without the extension.
  slug    String
  /// background | teaching_preference | learning_pattern | constraint
  kind    String
  /// The file's one-line header. What gets loaded for relevance selection once
  /// the memory outgrows what is worth injecting whole.
  summary String

  storagePath String @map("storage_path")
  contentHash String @map("content_hash")

  /// agent | user. The agent writes it; you own it.
  writtenBy      String    @default("agent") @map("written_by")
  /// User-reviewed, and therefore trusted more than an inference.
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  /// Supersede, never mutate. Seeing that a stated preference changed is the
  /// point; overwriting it quietly is how a model accumulates conclusions about
  /// somebody that nobody agreed to.
  supersededById String?   @map("superseded_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile      Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  supersededBy LearnerMemory?  @relation("MemorySupersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   LearnerMemory[] @relation("MemorySupersedes")

  @@unique([userId, slug])
  @@map("learner_memories")
}
