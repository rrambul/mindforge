# Copy to .env.local and fill in. Never commit the filled version.

# --- Supabase --------------------------------------------------------------
# Pooled connection for the app (pgbouncer). Prisma needs the pgbouncer flag.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection — migrations only. Never used at runtime.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_ANON_KEY=""
# Server-side only. BYPASSES RLS — worker queries must filter user_id by hand.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Anthropic -------------------------------------------------------------
# Present in `api` and `worker` only. Never in the web build (§11).
#
# The worker requires it at boot rather than at the first teach run: a process
# that starts happily and fails ten minutes into an agent run is the failure mode
# the SUPABASE_URL note in apps/worker/src/shared/env.ts exists to avoid.
#
# CI sets a placeholder. Nothing in the suites makes a live call — non-negotiable
# 8 — so a placeholder is not a stub, it is what the value correctly is there.
ANTHROPIC_API_KEY=""

# How a teach run authenticates: `api_key` (default) or `subscription`.
#
# `subscription` uses the Claude Code login on this machine instead of API credits — useful while
# you are still finding out whether the capture loop sticks. It only works where somebody has run
# `claude` and logged in, so nothing deployed can use it, and it gives up CLAUDE_CONFIG_DIR
# isolation because the credentials live in that directory. Fine for one person on their own laptop;
# not for a second user.
#
# The mode is explicit rather than inferred from whether a key is set: inferring means a deploy that
# loses its key silently falls back to a mode with no credentials to find.
TEACH_AUTH="api_key"

# What one learner may spend on teaching in a day, in USD (FR-T8).
#
# A run costs $1.47–$2.50 and is one button press. `MAX_BUDGET_USD` in teach-run.ts
# bounds a *single* run, and the single-active-run index is per *mission* — so
# without this a learner with six missions has six runs' worth in flight and no
# ceiling at all across a week.
#
# **Empty means no ceiling. `0` switches teaching off.** Those are different
# settings and the UI says a different sentence for each, so do not use a very
# large number to mean "unlimited" — it renders as a progress bar at 0%, which
# claims a measurement against a limit nobody set.
#
# Declared by `worker` as well as `api`, though only the API enforces it: the
# worker boots the API's TeachModule to reuse its use cases, so Nest constructs
# TeachSpend there too. Keep the two defaults identical.
TEACH_DAILY_BUDGET_USD="15"

# --- Redis (BullMQ) --------------------------------------------------------
# Deliberately unused. There is no Redis anywhere — not locally, not in CI, not
# in supabase/config.toml, not on Railway. The scheduler is a self-rescheduling
# setTimeout in `worker`, and idempotency lives in Postgres (see
# apps/worker/src/shared/env.ts, which does not read this). Left here so the
# swap to a real queue is a rename; do not provision Redis for it.
REDIS_URL="redis://localhost:6379"

# --- Origins ---------------------------------------------------------------
# The lessons origin MUST be a different host from the app, or the sandbox
# isolation in TECH-DESIGN.md §7.5 is decorative.
APP_ORIGIN="http://localhost:5173"
API_ORIGIN="http://localhost:3000"
LESSONS_ORIGIN="http://localhost:3001"

# Shared by `api` (which mints view grants) and `lessons` (which verifies them).
# It is the whole of the ownership check once the API has done its RLS test, so it
# is a credential: anyone holding it can read any workspace by signing its prefix.
#
# Both processes refuse to boot without it. That is deliberate — a lessons origin
# with the wrong secret answers 404 to every lesson and looks, in the logs, exactly
# like a user whose content has gone missing.
LESSONS_TOKEN_SECRET=""

# How much the API says about itself: fatal | error | warn | info | debug | trace | silent.
#
# `info` still answers "did this request arrive, whose was it, what did it cost".
# `debug` also surfaces the 401s the problem filter keeps quiet, which is what you
# want when sign-in is the thing that is broken. Output is JSON in every
# environment — pipe through `npx pino-pretty` locally if you want it readable
# (§14.2 says why the pretty-printer is not wired in).
LOG_LEVEL="info"

# --- Web (Vite: only VITE_* reaches the browser bundle) --------------------
VITE_API_ORIGIN="http://localhost:3000"
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_ANON_KEY=""
