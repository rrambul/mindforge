{
  "name": "@mindforge/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./teach": {
      "development": "./src/modules/teach/index.ts",
      "types": "./dist/modules/teach/index.d.ts",
      "default": "./dist/modules/teach/index.js"
    },
    "./shared": {
      "development": "./src/shared/index.ts",
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    }
  },
  "scripts": {
    "build": "nest build",
    "dev": "node --conditions=development --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:integration:coverage": "vitest run -c vitest.integration.config.ts --coverage"
  },
  "dependencies": {
    "@mindforge/core": "workspace:*",
    "@mindforge/db": "workspace:*",
    "@mindforge/llm": "workspace:*",
    "@mindforge/workspace": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "bullmq": "^5.81.3",
    "jose": "^6.2.8",
    "nestjs-pino": "^4.6.1",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@vitest/coverage-v8": "^4.1.10",
    "testcontainers": "^12.1.0",
    "typescript": "6.0.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  }
}
