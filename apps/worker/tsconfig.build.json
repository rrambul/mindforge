{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Only the emit config sets rootDir: tsconfig.json also includes test/** and
    // scripts/**, which live outside src, and tsc refuses a program whose rootDir
    // does not contain every file in it. Same split as apps/api.
    "rootDir": "./src",
    // Inside dist on purpose — see packages/core/tsconfig.build.json. Nest's CLI
    // picks this file up automatically for `nest build`.
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "exclude": ["node_modules", "dist", "test", "scripts", "**/*.test.ts"]
}
