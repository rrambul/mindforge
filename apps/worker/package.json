{
  "name": "@mindforge/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "node --conditions=development --import @swc-node/register/esm-register --watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "probe:teach": "node --conditions=development --import @swc-node/register/esm-register scripts/teach-probe.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "put:workspace": "node --conditions=development --import @swc-node/register/esm-register scripts/workspace-put.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.222",
    "@mindforge/api": "workspace:*",
    "@mindforge/core": "workspace:*",
    "@mindforge/db": "workspace:*",
    "@mindforge/llm": "workspace:*",
    "@mindforge/workspace": "workspace:*",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@supabase/supabase-js": "^2.112.1",
    "bullmq": "^5.81.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
