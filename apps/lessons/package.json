{
  "name": "@mindforge/lessons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/index.ts --target=bun --outdir=./dist",
    "dev": "bun --env-file=../../.env.local --watch src/index.ts",
    "start": "bun --env-file=../../.env.local src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/runner/browser/tsconfig.json",
    "test:unit": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "dependencies": {
    "@mindforge/core": "workspace:*",
    "@supabase/supabase-js": "^2.112.1",
    "pyodide": "^314.0.7",
    "sucrase": "^3.35.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  }
}
